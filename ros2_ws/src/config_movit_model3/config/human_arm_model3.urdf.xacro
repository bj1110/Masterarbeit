<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_model3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import alt_human_arm_model urdf file -->
    <xacro:include filename="/home/bjoern/Projects/Masterarbeit/ros2_ws/model3.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="human_arm_model3.ros2_control.xacro" />


    <xacro:human_arm_model3_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
