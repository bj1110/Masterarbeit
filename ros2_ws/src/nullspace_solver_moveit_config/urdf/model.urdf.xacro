<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotmodel">
    <xacro:macro name="cylinder_link_template" params="name mass radius height dir_y dir_z dir_x:='0.0' *origin color=''">
        <link name="${name}">
            <visual>
            <geometry>
                <cylinder length="${height}" radius="${radius}"/>
            </geometry>
            <xacro:insert_block name="origin"/>
            <xacro:if value="${color != ''}">
                <material name="${color}"/>
            </xacro:if>
            </visual>
            <collision>
            <xacro:insert_block name="origin"/>
            <geometry>
                <cylinder length="${height}" radius="${radius}"/>
            </geometry>
            </collision>

            <xacro:cylinder_inertia m="${mass}" r="${radius}" h="${height}" dir_y="${dir_y}" dir_z="${dir_z}" dir_x="${dir_x}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h dir_y dir_z dir_x">
        <inertial>
            <origin xyz="${dir_x * h/2.0} ${-1.0* dir_y*h/2.0} ${-1.0* dir_z*h/2.0}" rpy="0.0 0.0 0.0"/>
            <mass value="${m}"/>
            <inertia ixx="${(1/12)* m*(3*r*r + h*h) }" ixy="0.0" ixz="0.0" iyy="${(1/12)* m*(3*r*r + h*h) }" iyz="0.0" izz="${(1/2)*m*r*r}" />
        </inertial>
    </xacro:macro>

    <material name="blue">
        <color rgba="0 0 0.8 1"/>
    </material>

    <xacro:property name="height" value="0.1"/>

    <link name="base">
    </link>

    <xacro:cylinder_link_template name="link1" mass="1" radius="0.01" height="${height}" dir_y="1.0" dir_z="0">
        <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <joint name="world_joint" type="fixed">
        <parent link="base"/>
        <child link="link1"/>
        <origin xyz="0.0 0.0 0.0"/>
    </joint>

    <xacro:cylinder_link_template name="link2" mass="1" radius="0.01" height="${height}" dir_y="1.0" dir_z="0">
        <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <joint name="joint1" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0.0 0.0 ${height}"/>
        <axis xyz="0 1 0"/>
        <limit effort="1000.0" lower="${-90*math.pi/180}" upper="${90*math.pi/180}" velocity="0.5" />
    </joint>

    <xacro:cylinder_link_template name="link3" mass="1" radius="0.01" height="${height}" dir_y="1.0" dir_z="0">
        <origin xyz="0.0 0.0 ${height/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <joint name="joint2" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0.0 0.0 ${height}"/>
        <axis xyz="0 1 0"/>
        <limit effort="1000.0" lower="${-90*math.pi/180}" upper="${90*math.pi/180}" velocity="0.5" />
    </joint>

    <xacro:cylinder_link_template name="ee" mass="1" radius="0.005" height="0.01" dir_y="1.0" dir_z="0" color="blue">
        <origin xyz="0.0 0.0 ${0.01/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <joint name="joint3" type="fixed">
        <parent link="link3"/>
        <child link="ee"/>
        <origin xyz="0.0 0.0 ${height}"/>
        
    </joint>


</robot>