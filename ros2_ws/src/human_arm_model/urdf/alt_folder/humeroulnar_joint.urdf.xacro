<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="$(find human_arm_model)/urdf/macros.urdf.xacro" />

    <link name="forearm_yaw">
        <xacro:minimal_interia />
    </link>

    <xacro:joint_template bodypart="elbow" suffix="yaw" parent="humerus" child="forearm_yaw">
        <origin xyz="0.0 0.0 ${-upperarm_length}"/>
        <axis xyz="0.0 -1.0 0.0" />
        <limit effort="1000.0" lower="${humeroulnarjoint_extension}" upper="${humeroulnarjoint_flexion}" velocity="0.5" />
    </xacro:joint_template>


    <xacro:joint_template bodypart="elbow" suffix="roll" parent="forearm_yaw" child="forearm">
        <origin xyz="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0" />
        <limit effort="1000.0" lower="${humeroulnarjoint_supination}" upper="${humeroulnarjoint_pronation}" velocity="0.5" />
    </xacro:joint_template>



</robot>