<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />

    <!-- layout: -->
            <!-- 1. sternum -->
            <!-- 2. sternoclavicular joint -->
            <!-- 3. clavicular -->
            <!-- 4. glenohumaral joint -->
            <!-- 5. humerus -->
            <!-- 6. Humeroulnar joint -->
            <!-- 7. forearm -->
            <!-- 8. wrist joint -->
            <!-- 9. hand -->
        <!-- 7. and 8. are simplified significantly, both reduced from 2 subparts to 1, as the complexity is not needed here  -->

    <link name="base_link">
        <!-- <xacro:minimal_interia /> -->
    </link>
    
    <xacro:include filename="model2_folder/columna.urdf.xacro"/> 

    <!-- placeholder mass here -->
    <xacro:cylinder_link_template name="clavicular" mass="3" radius="${clavicle_raidus}" height="${clavicle_link_length}" dir_y="1.0" dir_z="0.0">
        <origin xyz="0.0 ${right * clavicle_link_length/2} 0.0" rpy="${math.pi/2} 0.0 0.0"/>
    </xacro:cylinder_link_template>


    <xacro:cylinder_link_template name="humerus" mass="${upperarm_weight}" radius="${upperarm_radius}" height="${upperarm_length}" dir_y="0.0" dir_z="1.0">
        <origin xyz="0.0 0.0 ${-upperarm_length/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <xacro:cylinder_link_template name="forearm" mass="${forearm_weight}" radius="${forearm_circumference / (2*math.pi)}" height="${elbow_wrist_length}" dir_y="0.0" dir_z="1.0">
        <origin xyz="0.0 0.0 ${-elbow_wrist_length/2}" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_link_template>

    <!-- <xacro:bodypart_template bodypart="wrist" suffix="yaw" parent="forearm" child="hand">
        <origin xyz="0.0 0.0 ${-elbow_wrist_length}"/>
        <axis xyz="1.0 0.0 0.0" />
        <limit effort="1000.0" lower="${hand_palmarflexion}" upper="${hand_dorsalextension}" velocity="0.5" />
    </xacro:bodypart_template> -->

    <joint name="forearm_hand_joint" type="fixed">
        <parent link="forearm"/>
        <child link="hand"/>
        <origin xyz="0.0 0.0 ${-elbow_wrist_length}"/>
    </joint>

    <link name="hand">
        <visual>
            <geometry>
                <box size="${hand_thickness} ${hand_length} ${hand_width}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${-hand_length/2}" rpy="${90*math.pi/180} 0.0 ${90*math.pi/180}"/>
        </visual>
        <collision>
            <geometry>
                <box size="${hand_thickness} ${hand_length} ${hand_width}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${-hand_length/2}" rpy="${90*math.pi/180} 0.0 ${90*math.pi/180}"/>
        </collision>
        <xacro:box_inertia m="${hand_weight}" x="${hand_thickness}" y="${hand_length}" z="${hand_width}" >
            <origin xyz="0.0 0.0 ${-hand_length/2}" rpy="0.0 0.0 0.0"/>
        </xacro:box_inertia>
    </link>

    
    <xacro:cylinder_link_template name="can" mass="${can_weight}" radius="${can_radius}" height="${can_height}" dir_y="0.0" dir_z="0.0" dir_x="-1.0">
        <origin xyz="${-can_height/2} 0.0 0.0" rpy="${90*math.pi/180} 0.0 ${90*math.pi/180}"/>
    </xacro:cylinder_link_template>
    
    <joint name="hand_can_joint" type="fixed">
        <parent link="hand"/>
        <child link="can"/>
        <origin xyz="${can_height/2} ${right * (-(hand_thickness/2) - can_radius) } ${-hand_length}"/>
    </joint>

    <xacro:include filename="model2_folder/sternoclavicular_joint.urdf.xacro" />
    <xacro:include filename="model2_folder/glenohumeral_joint.urdf.xacro" />
    <xacro:include filename="model2_folder/humeroulnar_joint.urdf.xacro" />
    <!-- <xacro:include filename="model2_folder/alt_gazebo.urdf.xacro" /> -->
</robot>