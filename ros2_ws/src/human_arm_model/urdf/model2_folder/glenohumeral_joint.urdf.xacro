<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="$(find human_arm_model)/urdf/macros.urdf.xacro" />

    <link name="humerus_yaw">
        <xacro:minimal_interia />
    </link>

    <link name="humerus_pitch">
        <xacro:minimal_interia />
    </link>
    
    <xacro:joint_template bodypart="glenohumeral" suffix="yaw" parent="clavicular" child="humerus_yaw" >
        <origin xyz="0.0 ${right * clavicle_link_length} 0.0" rpy="0.0 0.0 ${right * -30*math.pi/180}"/>
        <axis xyz="${right} 0.0 0.0" />
        <limit effort="1000.0" lower="${glenohumeraljoint_adduktion}" upper="${glenohumeraljoint_abduktion}" velocity="0.5" />
    </xacro:joint_template>


    <xacro:joint_template bodypart="glenohumeral" suffix="pitch" parent="humerus_yaw" child="humerus_pitch">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="0.0 -1.0 0.0" />
        <limit effort="1000.0" lower="${glenohumeraljoint_retroversion}" upper="${glenohumeraljoint_anteversion}" velocity="0.5" />
    </xacro:joint_template>


    <xacro:joint_template bodypart="glenohumeral" suffix="roll" parent="humerus_pitch" child="humerus">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="0.0 0.0 1.0" />
        <limit effort="1000.0" lower="${glenohumeraljoint_endorotation}" upper="${glenohumeraljoint_exorotation}" velocity="0.5" />
    </xacro:joint_template>


</robot>