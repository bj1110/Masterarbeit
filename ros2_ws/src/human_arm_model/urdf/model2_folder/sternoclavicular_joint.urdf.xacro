<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="$(find human_arm_model)/urdf/macros.urdf.xacro" />

    <link name="clavicular_yaw">
        <xacro:minimal_interia />
    </link>
    
    <link name="clavicular_pitch">
        <xacro:minimal_interia />
    </link>

    <xacro:joint_template bodypart="sternoclavicular" suffix="yaw" parent="columna" child="clavicular_yaw" >
        <origin xyz="0.0 ${right * sternum_radius} ${2*waist_back_length}" rpy="0.0 0.0 ${30*math.pi/180}" />
        <axis xyz="${right} 0.0 0.0" />
        <limit effort="1000.0" lower="${Sternoklavikularjoint_depression}" upper="${Sternoklavikularjoint_elevation}" velocity="0.5" />
    </xacro:joint_template>


    <xacro:joint_template bodypart="sternoclavicular" suffix="pitch" parent="clavicular_yaw" child="clavicular_pitch">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="0.0 0.0 1.0" />
        <limit effort="1000.0" lower="${Sternoklavikularjoint_retraktion}" upper="${Sternoklavikularjoint_protraktion}" velocity="0.5" />
    </xacro:joint_template>


    <xacro:joint_template bodypart="sternoclavicular" suffix="roll" parent="clavicular_pitch" child="clavicular">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0" />
        <limit effort="1000.0" lower="${Sternoklavikularjoint_posteriorrotation}" upper="${Sternoklavikularjoint_anteriorrotation}" velocity="0.5" />
    </xacro:joint_template>

</robot>