<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="upperarm_length" value="0.3637"/>
    <xacro:property name="elbow_wrist_length" value="0.2869"/>
    <xacro:property name="upperarm_circumference" value="0.3581"/>
    <xacro:property name="wrist_circumference" value="0.1759"/>
    <xacro:property name="forearm_circumference" value="0.3101"/>
    <xacro:property name="can_radius" value="0.035"/>
    <xacro:property name="can_height" value="0.12" />
    <xacro:property name="hand_lenght" value="" />
    <xacro:property name="hand_height" value="" />
    <xacro:property name="hand_width" value="" />

    <!-- ___________________ Macro for joints __________ -->

    <xacro:macro name="bodypart_template" params="bodypart suffix parent child:='' *origin *axis *limit">
        <joint name="${bodypart}_${suffix}_joint" type="revolute">
            <parent link="${parent if (parent in ['torso', 'upperarm', 'forearm']) else bodypart+'_'+parent+'_link'}"/>
            <child link="${child if child != '' else bodypart+'_' + suffix + '_link'}"/>
            <xacro:insert_block name="origin"/>
            <xacro:insert_block name="axis"/>
            <xacro:insert_block name="limit"/>
        </joint>
        <xacro:if value="${child == ''}">
            <link name="${bodypart}_${suffix}_link">
            </link>
        </xacro:if>
    </xacro:macro>
</robot>