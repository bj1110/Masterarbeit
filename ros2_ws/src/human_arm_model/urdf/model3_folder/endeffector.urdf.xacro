<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="macros2.urdf.xacro" />

    <link name="${prefix}hand">
        <visual>
            <geometry>
                <box size="${hand_thickness} ${hand_length} ${hand_width}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${-hand_length/2}" rpy="${90*math.pi/180} 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="${hand_thickness} ${hand_length} ${hand_width}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${-hand_length/2}" rpy="${90*math.pi/180} 0.0 0.0"/>
        </collision>
        <xacro:box_inertia m="${hand_weight}" x="${hand_thickness}" y="${hand_length}" z="${hand_width}" />
    </link>

    <xacro:joint_template2 bodypart="wrist" suffix="flexion" parent="forearm" child="hand">
        <origin xyz="0.0 0.0 ${-elbow_wrist_length}"/>
        <axis xyz="0.0 1.0 0.0" />
        <limit effort="1000.0" lower="${hand_palmarflexion}" upper="${hand_dorsalextension}" velocity="0.5" />
    </xacro:joint_template2>

    
    <xacro:cylinder_link_template2 name="can" mass="${can_weight}" radius="${can_radius}" height="${can_height}">
        <origin xyz="0.0 ${-can_height/2} 0.0" rpy="${90*math.pi/180} 0.0 0.0"/>
    </xacro:cylinder_link_template2>
    
    <joint name="${prefix}hand_can_joint" type="fixed">
        <parent link="${prefix}hand"/>
        <child link="${prefix}can"/>
        <origin xyz="${-can_radius} ${can_height/2} ${-hand_length}"/>
    </joint>


</robot>