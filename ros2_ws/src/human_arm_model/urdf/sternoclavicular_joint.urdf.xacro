<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />


    <xacro:joint_template bodypart="sternoclavicular" suffix="yaw" parent="columna" child="clavicular_yaw" >
        <origin xyz="0 ${sternum_radius} ${waist_back_length}" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="${Sternoklavikularjoint_depression}" upper="${Sternoklavikularjoint_elevation}" velocity="0.5" />
    </xacro:joint_template>

    <link name="clavicular_yaw"/>

    <xacro:joint_template bodypart="sternoclavicular" suffix="pitch" parent="clavicular_yaw" child="clavicular_pitch">
        <origin xyz="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="${Sternoklavikularjoint_retraktion}" upper="${Sternoklavikularjoint_protraktion}" velocity="0.5" />
    </xacro:joint_template>

    <link name="clavicular_pitch"/>

    <xacro:joint_template bodypart="sternoclavicular" suffix="roll" parent="clavicular_pitch" child="clavicular">
        <origin xyz="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000" lower="${Sternoklavikularjoint_posteriorrotation}" upper="${Sternoklavikularjoint_anteriorrotation}" velocity="0.5" />
    </xacro:joint_template>

</robot>