<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alt_human_arm_model">

    <xacro:include filename="constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />

    <xacro:joint_template bodypart="glenohumeral" suffix="yaw" parent="clavicular" child="humerus_yaw" >
        <origin xyz="0 ${clavicle_link_length} 0" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="${glenohumeraljoint_adduktion}" upper="${glenohumeraljoint_abduktion}" velocity="0.5" />
    </xacro:joint_template>

    <link name="humerus_yaw"/>

    <xacro:joint_template bodypart="glenohumeral" suffix="pitch" parent="humerus_yaw" child="humerus_pitch">
        <origin xyz="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit effort="1000" lower="${glenohumeraljoint_retroversion}" upper="${glenohumeraljoint_anteversion}" velocity="0.5" />
    </xacro:joint_template>

    <link name="humerus_pitch"/>

    <xacro:joint_template bodypart="glenohumeral" suffix="roll" parent="humerus_pitch" child="humerus">
        <origin xyz="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="${glenohumeraljoint_endorotation}" upper="${glenohumeraljoint_exorotation}" velocity="0.5" />
    </xacro:joint_template>


</robot>