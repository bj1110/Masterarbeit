<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_model">

    <xacro:include filename="constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />

    <!-- layout: -->
            <!-- 1. sternum -->
            <!-- 2. sternoclavicular joint -->
            <!-- 3. clavicular -->
            <!-- 4. glenohumaral joint -->
            <!-- 5. humerus -->
            <!-- 6. Humeroulnar joint -->
            <!-- 7. forearm -->
            <!-- 8. wrist joint -->
            <!-- 9. hand -->
        <!-- 7. and 8. are simplified significantly, both reduced from 2 subparts to 1, as the complexity is not needed here  -->


    <link name="columna"> <!-- carla columna-->
        <visual>
            <geometry>
                <box size="${sternum_radius*2} ${sternum_radius*2} ${waist_back_length}"/>
            </geometry>
        </visual>
    </link>

    <xacro:bodypart_template bodypart="sternoclavicular" suffix="yaw" parent="columna" child="clavicular" >
        <origin xyz="0 ${sternum_radius} ${waist_back_length}" />
        <axis xyz="0 -1 0" />
        <limit effort="1000" lower="-1.1" upper="1.9" velocity="0.5" />
    </xacro:bodypart_template>

    <link name="clavicular">
        <visual>
            <geometry>
                <box size="${sternum_radius*2} ${sternum_radius*2} ${waist_back_length}"/>
            </geometry>
        </visual>
    </link>


</robot>