<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_modell">
    <xacro:property name="upperarm_length" value="0.3637"/>
    <xacro:property name="elbow_wrist_length" value="0.2869"/>
    <xacro:property name="upperarm_circumference" value="0.3581"/>
    <xacro:property name="wrist_circumference" value="0.1759"/>
    <xacro:property name="forearm_circumference" value="0.3101"/>

    <link name="torso">
        <visual>
            <geometry>
                <box size="1.0 1.0 1.0"/>
            </geometry>
        </visual>
    </link>
    
    <joint name="shoulder_joint" type="continuous">
        <parent link="torso"/>
        <child link="upperarm"/>
        <origin xyz="0.5 0 0.5"/>
    </joint>

    <link name="upperarm">
        <visual>
            <geometry>
                <cylinder length="${upperarm_length}" radius="${upperarm_circumference/ (2* math.pi)}"/> 
            </geometry>
            <origin xyz="${upperarm_length/2} 0 0" rpy="0 ${math.pi/2} 0" />
        </visual>
    </link>

    <joint name="elbow_joint" type="continuous">
        <parent link="upperarm"/>
        <child link="forearm"/>
        <origin xyz="${upperarm_length} 0 0"/>
    </joint>

    <link name="forearm">
        <visual>
            <geometry>
                <cylinder length="${elbow_wrist_length}" radius="${forearm_circumference / (2*math.pi)}" />
            </geometry>
        </visual>

    </link>

</robot>