<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />

    <link name="${prefix}elbow_1">
        <xacro:minimal_inertia />
    </link>


    <xacro:joint_template2 bodypart="elbow" suffix="flexion" parent="upperarm" child="elbow_1">
        <origin xyz="0.0 0.0 ${-upperarm_length}"/>
        <axis xyz="1.0 0.0 0.0" />
        <limit effort="1000.0" lower="${humeroulnarjoint_extension}" upper="${humeroulnarjoint_flexion}" velocity="0.5" />
    </xacro:joint_template2>


    <xacro:joint_template2 bodypart="elbow" suffix="rotation" parent="elbow_1" child="forearm">
        <origin xyz="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0" />
        <limit effort="1000.0" lower="${humeroulnarjoint_supination}" upper="${humeroulnarjoint_pronation}" velocity="0.5" />
    </xacro:joint_template2> 

</robot>