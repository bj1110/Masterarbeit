<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="human_arm_model">

    <xacro:include filename="$(find human_arm_model)/urdf/constants.urdf.xacro" />
    <xacro:include filename="macros.urdf.xacro" />

    <link name="${prefix}shoulder_1">
        <xacro:minimal_inertia />
    </link>
    <link name="${prefix}shoulder_2">
        <xacro:minimal_inertia />
    </link>


    <xacro:joint_template2 bodypart="shoulder" suffix="rotation" parent="torso" child="shoulder_1" >
        <origin xyz="${clavicle_link_length} 0.0 ${2*waist_back_length}" rpy="0.0 0.0 0.0" />
        <axis xyz="0.0 0.0 1.0" />
                <limit effort="1000.0" lower="${glenohumeraljoint_endorotation}" upper="${glenohumeraljoint_exorotation}" velocity="0.5" />
    </xacro:joint_template2>

    <xacro:joint_template2 bodypart="shoulder" suffix="abduction" parent="shoulder_1" child="shoulder_2">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="0.0 -1.0 0.0" />
        <limit effort="1000.0" lower="${shoulder_ab_min}" upper="${shoulder_ab_max}" velocity="0.5" />
    </xacro:joint_template2>

    <xacro:joint_template2 bodypart="shoulder" suffix="flexion" parent="shoulder_2" child="upperarm">
        <origin xyz="0.0 0.0 0.0" />
        <axis xyz="1.0 0.0 0.0" />
        <limit effort="1000.0" lower="${shoulder_flex_min}" upper="${shoulder_flex_max}" velocity="0.5" />
    </xacro:joint_template2>


</robot>